# development | test | integration | production
APP_ENV=development
LOG_LEVEL=INFO
# Local development uses SQLite. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./data/enterprise_agent.db
POSTGRES_PASSWORD=replace-with-random-local-password
AGENT_MAX_STEPS=10
TOOL_TIMEOUT_SECONDS=10
TOOL_MAX_RETRIES=2

# rule_based keeps local tests deterministic. Set openai when an API is configured.
PLANNER_MODE=rule_based
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Set both prices to enable estimated_cost_usd; leave blank when unknown.
LLM_INPUT_COST_PER_MILLION=
LLM_OUTPUT_COST_PER_MILLION=

# Development identity. Production must disable the dev endpoint and inject a
# non-default verification secret, public key, or JWKS URL.
JWT_ISSUER=enterprise-ai-agent
JWT_AUDIENCE=enterprise-ai-agent-api
JWT_ALGORITHM=HS256
JWT_SECRET=development-only-change-me-32-bytes
JWT_PUBLIC_KEY=
JWKS_URL=
JWT_TOKEN_TTL_SECONDS=3600
ALLOW_DEV_IDENTITY=true

# Reuse agent01 through its existing POST /api/v1/chat endpoint.
KNOWLEDGE_BACKEND=sample
AGENT01_BASE_URL=http://host.docker.internal:8000
AGENT01_BEARER_TOKEN=
AGENT01_KNOWLEDGE_BASE_ID=
KNOWLEDGE_FALLBACK_TO_SAMPLE=true
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PROMETHEUS_ENABLED=true

API_PORT=8001
