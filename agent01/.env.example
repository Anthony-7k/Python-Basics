LLM_API_KEY=your_api_key_here

LLM_BASE_URL=https://api.deepseek.com

LLM_MODEL=deepseek-chat


EMBEDDING_API_KEY=your_embedding_api_key_here

EMBEDDING_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

EMBEDDING_MODEL=text-embedding-v4

EMBEDDING_DIMENSIONS=1024

CHROMA_PATH=data/chroma

DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/agent01?charset=utf8mb4

DEFAULT_KNOWLEDGE_BASE_NAME=Default Knowledge Base

# 演示认证：JSON 的 key 是 Bearer Token，value 是用户邮箱。
# 请用随机值替换占位符；不要提交真实凭证。
DEMO_AUTH_USERS_JSON={"replace-with-random-demo-token":"local-user@agent01.local"}
# Streamlit 使用同一 Token 调用 FastAPI。
DEMO_API_KEY=replace-with-random-demo-token

RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT_REQUESTS=10
CHAT_RATE_LIMIT_REQUESTS=30

# Day19 有限 Agent：最多步骤、单工具超时、总预算和文档证据上限。
AGENT_MAX_TOOL_STEPS=2
AGENT_TOOL_TIMEOUT_SECONDS=15
AGENT_REQUEST_BUDGET_SECONDS=25
AGENT_MAX_DOCUMENT_CHUNKS=20
AGENT_MAX_DOCUMENT_CHARS=12000

CONVERSATION_HISTORY_MAX_TURNS=3
CONVERSATION_HISTORY_TOKEN_BUDGET=1800
CONVERSATION_SUMMARY_MAX_CHARS=2000

REDIS_URL=redis://localhost:6379/0
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=300
RAG_RETRIEVAL_MAX_DISTANCE=1.1
RAG_RETRIEVAL_MODE=vector
RAG_RETRIEVAL_CANDIDATE_MULTIPLIER=3
RAG_KEYWORD_TOP_K=20
RAG_KEYWORD_MIN_SCORE=0.3
RAG_RRF_K=60
RAG_RERANKER_MODEL=lexical-v1
RAG_RERANK_LEXICAL_WEIGHT=0.7
REDIS_CONNECT_TIMEOUT_SECONDS=0.2
REDIS_SOCKET_TIMEOUT_SECONDS=0.2

API_BASE_URL=http://127.0.0.1:8000
