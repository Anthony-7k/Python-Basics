# Copy these values into .env, then fill in the endpoint and key from your console.
# API endpoint and API key must belong to the same region/workspace.
# Only turn on cloud extraction after confirming paid use and data transfer.
OCR_BACKEND=rapidocr
EXTRACTION_BACKEND=cloud
CLOUD_MODEL_PROVIDER=dashscope
CLOUD_MODEL_NAME=qwen-plus
CLOUD_MODEL_BASE_URL=
CLOUD_MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=90
MODEL_RETRIES=1
