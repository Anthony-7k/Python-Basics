APP_ENV=development
SECRET_KEY=change-this-in-non-development-environments
DATABASE_URL=sqlite:///./data/docflow.db
PUBLIC_BASE_URL=http://127.0.0.1:8003
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ACCESS_TOKEN_MINUTES=60
SELECTION_TOKEN_MINUTES=5
AUTO_CREATE_SCHEMA=true
SEED_DEMO_DATA=true
OBJECT_STORAGE_BACKEND=filesystem
OBJECT_STORAGE_PATH=./data/objects
S3_ENDPOINT=http://minio:9000
S3_BUCKET=docflow
S3_ACCESS_KEY=docflow
S3_SECRET_KEY=change-me
VIRUS_SCANNER_BACKEND=fake
REPORT_RENDERER_BACKEND=pymupdf
TASK_QUEUE_BACKEND=eager
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
MAX_UPLOAD_BYTES=26214400
LOG_LEVEL=INFO
METRICS_ENABLED=true
OCR_BACKEND=fake
EXTRACTION_BACKEND=deterministic
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
MODEL_TIMEOUT_SECONDS=90
MODEL_RETRIES=1
